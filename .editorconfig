root = true

# Общие правила для всех файлов: LF в рабочей копии, чтобы Windows-редакторы
# не превращали переводы строк в CRLF (совместная работа Windows + WSL).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# В Markdown два пробела в конце строки — жёсткий перенос, их не обрезаем.
[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl}]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 100
