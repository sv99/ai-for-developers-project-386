{
  "name": "ai-for-developers-project-386",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:check": "run-s \"lint:check:*\"",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint .",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "tsp:check": "tsp compile typespec/main.tsp --no-emit",
    "openapi": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "deploy:render": "node scripts/deploy.mjs",
    "api:types": "openapi-typescript docs/openapi.yaml -o src/api/generated/schema.ts",
    "api:sdk": "run-s api:types gen-sdk",
    "gen-sdk": "node scripts/generate-sdk.mjs",
    "generate": "run-s openapi api:sdk server:gen",
    "server:build": "go -C server build -o ./bin/ ./cmd/server",
    "server:dev": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar go -C server run ./cmd/server",
    "server:test": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar go -C server test -p 1 ./...",
    "server:vet": "go -C server vet ./...",
    "server:gen": "go -C server tool oapi-codegen --config oapi-codegen.yaml ../docs/openapi.yaml",
    "db:up": "docker compose -f server/compose.yaml up -d --wait",
    "db:down": "docker compose -f server/compose.yaml down",
    "e2e:server": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar go -C server run ./cmd/server",
    "e2e:reset": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar go -C server run ./cmd/e2e-reset",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "1.16.0",
    "@typespec/openapi3": "1.16.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.83.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.68.0",
    "oxlint": "~1.83.0",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
